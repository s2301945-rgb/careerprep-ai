# HTTP service
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Auth: SUPABASE_URL + publishable/anon key only for server-side token verification
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Private Storage. Keep the service-role key on the backend only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes

# PostgreSQL runtime role (careerprep_api); remote URLs must use verified TLS.
DATABASE_URL=
DATABASE_SSL_CA=

# Privileged migration connection. Never use this as DATABASE_URL.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_SSL_CA=

# Test-only connection, used only by `npm run test:integration`.
TEST_DATABASE_URL=
TEST_DATABASE_DISPOSABLE=false

# Optional Sprint 1 connectivity diagnostic. Keep the key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
